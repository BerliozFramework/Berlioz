{
  "name": "berlioz/twig-package",
  "description": "Twig package for Berlioz Framework",
  "type": "berlioz-package",
  "license": "MIT",
  "homepage": "https://getberlioz.com",
  "support": {
    "issues": "https://github.com/BerliozFramework/Berlioz/issues",
    "source": "https://github.com/BerliozFramework/Berlioz"
  },
  "authors": [
    {
      "name": "Ronan Giron",
      "email": "ronan@getberlioz.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Berlioz\\Package\\Twig\\": ""
    }
  },
  "require": {
    "php": "^8.2",
    "ext-intl": "*",
    "berlioz/core": "self.version",
    "berlioz/helpers": "^1.0",
    "twig/twig": "^3.0"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "3.x-dev"
    }
  },
  "config": {
    "sort-packages": true,
    "berlioz": {
      "package": "Berlioz\\Package\\Twig\\BerliozPackage"
    }
  }
}
