{
  berlioz: {
    queues: {
      queues: [],
      handlers: {
        "berlioz:command": "Berlioz\\Package\\QueueManager\\Handler\\BerliozCommandJobHandler",
        // The `berlioz:system` handler executes system commands from the (untrusted) job payload.
        // It is intentionally NOT registered by default to avoid RCE. Opt-in explicitly if you
        // fully trust every queue producer:
        //   "berlioz:system": "Berlioz\\Package\\QueueManager\\Handler\\BerliozSystemJobHandler",
      },
      factories: [
        "Berlioz\\Package\\QueueManager\\Factory\\MemoryQueueFactory",
        "Berlioz\\Package\\QueueManager\\Factory\\AwsSqsQueueFactory",
        "Berlioz\\Package\\QueueManager\\Factory\\DbQueueFactory",
        "Berlioz\\Package\\QueueManager\\Factory\\RedisQueueFactory",
        "Berlioz\\Package\\QueueManager\\Factory\\AmqpQueueFactory",
        "Berlioz\\Package\\QueueManager\\Factory\\RabbitMqQueueFactory",
        "Berlioz\\Package\\QueueManager\\Factory\\NullQueueFactory"
      ],
      // Queues consumed on application terminate, i.e. after the HTTP response has been sent
      // (or at the end of a CLI command). Memory queues are purged afterwards.
      deferred: {
        queues: [],
        time_limit: null
      },
      // HTTP metrics endpoint. Opt-in: disabled by default. When `berlioz/http-core` is installed,
      // the middleware below serves queue metrics on `path`, gated by the client IP allow-list
      // (`ip`) and/or an optional bearer `token`.
      metrics: {
        enable: false,
        path: "/metrics/queues",
        format: "prometheus",
        ip: [],
        token: null,
        prometheus_labels: {},
        total: false
      }
    },
    http: {
      middlewares: {
        "1": {
          queue_metrics: "Berlioz\\Package\\QueueManager\\Http\\QueueMetricsMiddleware"
        }
      }
    }
  },
  commands: {
    "queue:size": "Berlioz\\Package\\QueueManager\\Command\\QueueSizeCommand",
    "queue:purge": "Berlioz\\Package\\QueueManager\\Command\\QueuePurgeCommand",
    "queue:worker": "Berlioz\\Package\\QueueManager\\Command\\QueueWorkerCommand"
  }
}
