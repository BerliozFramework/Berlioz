{
  "name": "berlioz/queue-manager-package",
  "description": "Queue Manager package for Berlioz Framework",
  "type": "berlioz-package",
  "license": "MIT",
  "homepage": "https://getberlioz.com",
  "support": {
    "issues": "https://github.com/BerliozFramework/Berlioz/issues",
    "source": "https://github.com/BerliozFramework/Berlioz"
  },
  "authors": [
    {
      "name": "Ronan Giron",
      "email": "ronan@getberlioz.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Berlioz\\Package\\QueueManager\\": ""
    }
  },
  "require": {
    "php": "^8.2",
    "berlioz/cli-core": "self.version",
    "berlioz/queue-manager": "self.version"
  },
  "suggest": {
    "ext-pcntl": "To use signals to exit worker",
    "ext-redis": "To use Redis queue",
    "ext-amqp": "To use AMQP queue",
    "aws/aws-sdk-php": "To use AWS SQS service",
    "hectororm/query": "To use database queue",
    "berlioz/http-core": "To expose the queue metrics HTTP endpoint (/metrics/queues)"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "3.x-dev"
    }
  },
  "config": {
    "sort-packages": true,
    "berlioz": {
      "package": "Berlioz\\Package\\QueueManager\\BerliozPackage"
    }
  }
}
