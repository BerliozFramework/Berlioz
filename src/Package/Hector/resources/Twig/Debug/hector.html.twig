{% extends "@Berlioz-HttpCore/Twig/Debug/_main.html.twig" %}

{% block menu %}
    <span class="nav-icon">
        <i class="bi bi-server"></i>
        {% if section|length > 0 %}
            <span class="badge bg-primary">{{ section|length }}</span>
        {% endif %}
    </span>
    <span class="nav-text">{{ section.sectionName }}</span>
{% endblock %}

{% block widget %}
    <div class="d-flex align-items-center mb-3">
        <i class="bi bi-server fs-1 me-3"></i>
        <p class="card-value mb-0">{{ section|length }} <small>queries</small></p>
    </div>
    <div class="d-flex align-items-center mt-3">
        <i class="bi bi-clock-history fs-1 me-3"></i>
        <p class="card-value ms-3 mb-0">
            {% if section.duration == 0 %}
                --
            {% else %}
                {{ (section.duration * 1000)|round(3) }} ms
            {% endif %}
        </p>
    </div>
    {% if section.countDuplicates > 0 %}
        <div class="d-flex align-items-center mt-3">
            <i class="bi bi-files fs-1 me-3 text-warning"></i>
            <p class="card-value ms-3 mb-0 text-warning">{{ section.countDuplicates }} <small>duplicates</small></p>
        </div>
    {% endif %}
{% endblock %}

{% block main %}
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1>
            {{ section.sectionName }}
            {% if section|length > 0 %}
                <span class="badge bg-primary">{{ section|length }}</span>
            {% endif %}
        </h1>
    </div>
    <p>
        It's a snapshot of database queries at the moment of request.
    </p>

    {% if section.logs is empty %}
        <div class="alert alert-secondary" role="alert">
            No query executed
        </div>
    {% else %}
        <div class="row justify-content-center">
            <div class="col-12 col-sm-6 col-md-4 mb-3">
                <div class="card text-bg-dark text-center">
                    <div class="card-body">
                        <i class="bi bi-server fs-1"></i>
                        <p class="card-value mb-0">{{ section|length }}</p>
                        <p class="card-text">queries</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4 mb-3">
                <div class="card text-bg-dark text-center">
                    <div class="card-body">
                        <i class="bi bi-clock-history fs-1"></i>
                        <p class="card-value mb-0">{{ (section.duration * 1000)|round(3) }} ms</p>
                        <p class="card-text">Execution time</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4 mb-3">
                <div class="card text-center {{ section.countDuplicates > 0 ? 'text-bg-warning' : 'text-bg-dark' }}">
                    <div class="card-body">
                        <i class="bi bi-files fs-1"></i>
                        <p class="card-value mb-0">{{ section.countDuplicates }}</p>
                        <p class="card-text">Duplicate queries</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>#</th>
                    <th>Connection</th>
                    <th>Duration</th>
                    <th>Statement</th>
                    <th>Values</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for logEntry in section.logs %}
                    {% set severity = section.getSeverity(logEntry) %}
                    <tr>
                        <th>{{ loop.index }}</th>
                        <td>{{ logEntry.connection }}</td>
                        <td class="text-nowrap">
                            {% if severity == 'danger' %}
                                <i data-bs-toggle="tooltip"
                                   title="Very slow query (>= {{ section.verySlowThreshold|round }}ms)"
                                   class="bi bi-exclamation-triangle-fill text-danger"></i>
                            {% elseif severity == 'warning' %}
                                <i data-bs-toggle="tooltip"
                                   title="Slow query (>= {{ section.slowThreshold|round }}ms)"
                                   class="bi bi-exclamation-triangle-fill text-warning"></i>
                            {% endif %}
                            {{ (logEntry.duration * 1000)|round(3) }}ms
                        </td>
                        <td>
                            <div class="code mb-0">
                                {% set interpolated = section.getInterpolatedStatement(loop.index0) %}
                                <div class="btn-group-vertical">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            data-toggle="copy"
                                            data-target="#hector-statement-{{ loop.index }}"
                                            title="Copy query">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                    {% if interpolated %}
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                data-toggle="copy"
                                                data-text="{{ interpolated }}"
                                                title="Copy query with values">
                                            <i class="bi bi-clipboard-check"></i>
                                        </button>
                                    {% endif %}
                                </div>
                                <pre><code class="sql max-vh-50"
                                           id="hector-statement-{{ loop.index }}">{{ logEntry.statement }}</code></pre>
                            </div>
                            {% if severity == 'danger' %}
                                <span class="badge bg-danger mt-2"
                                      data-bs-toggle="tooltip"
                                      title="Very slow query (>= {{ section.verySlowThreshold|round }}ms)">
                                    <i class="bi bi-exclamation-triangle-fill"></i> Very slow query
                                </span>
                            {% elseif severity == 'warning' %}
                                <span class="badge bg-warning mt-2"
                                      data-bs-toggle="tooltip"
                                      title="Slow query (>= {{ section.slowThreshold|round }}ms)">
                                    <i class="bi bi-exclamation-triangle-fill"></i> Slow query
                                </span>
                            {% endif %}
                            {% set duplicateCount = section.getDuplicateCount(loop.index0) %}
                            {% if duplicateCount is not null %}
                                <span class="badge bg-warning mt-2"
                                      data-bs-toggle="tooltip"
                                      title="This query was executed {{ duplicateCount }} times with the same values">
                                    <i class="bi bi-files"></i> Executed {{ duplicateCount }}&times;
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="max-vh-50">
                                {% if logEntry.parameters|length > 0 %}
                                    <table class="table table-striped table-sm table-bordered mb-0">
                                        <thead>
                                        <tr>
                                            <th scope="col">Key</th>
                                            <th scope="col">Type</th>
                                            <th scope="col">Value</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% for param in logEntry.parameters %}
                                            <tr>
                                                <th scope="row">{{ param.name }}</th>
                                                <td>{{ param.dataType }}</td>
                                                <td><span data-toggle="copy" data-text="{{ param.value|e('html_attr') }}">{{ param.value }}</span></td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                {% else %}
                                    --
                                {% endif %}
                            </div>
                        </td>
                        <td class="text-end">
                            {% if logEntry.trace %}
                                <button class="btn btn-sm btn-outline-secondary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#hectorDetail"
                                        data-detail="{{ logEntry.trace|trim }}">
                                    <i class="bi bi-search"></i>
                                </button>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    <!-- Modal -->
    <div class="modal fade" id="hectorDetail" tabindex="-1" role="dialog" aria-labelledby="hectorDetailTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="hectorDetailTitle">Statement trace</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="code">
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                data-toggle="copy"
                                data-target="#hectorDetailCode"
                                title="Copy trace">
                            <i class="bi bi-clipboard"></i>
                        </button>
                        <pre id="hectorDetailCode"></pre>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block inlineJscripts %}
    <script>
        var modalEl = document.getElementById('hectorDetail');
        modalEl.addEventListener('show.bs.modal', function (event) {
            modalEl.querySelector('.modal-body pre').innerHTML = event.relatedTarget.dataset.detail;
        })
    </script>
{% endblock %}
