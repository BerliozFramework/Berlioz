{
  "name": "berlioz/config",
  "description": "Berlioz Configuration is a PHP library to manage your configuration files.",
  "license": "MIT",
  "homepage": "https://getberlioz.com",
  "support": {
    "issues": "https://github.com/BerliozFramework/Berlioz/issues",
    "source": "https://github.com/BerliozFramework/Berlioz"
  },
  "authors": [
    {
      "name": "Ronan Giron",
      "email": "ronan@getberlioz.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Berlioz\\Config\\": ""
    }
  },
  "require": {
    "php": "^8.2",
    "berlioz/helpers": "^1.10",
    "colinodell/json5": "^2.2.1"
  },
  "suggest": {
    "ext-yaml": "To use YamlAdapter with Config",
    "symfony/yaml": "To use YamlAdapter with Config"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "3.x-dev"
    }
  },
  "config": {
    "sort-packages": true
  }
}
